# Gemini API Key
GEMINI_API_KEY=

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Emergency services numbers used by the distress dispatch pipeline (server-side only).
# HOSPITAL_NUMBER is prepended to contacts on medical incidents (VOICE_HELP / MEDICAL / CRASH).
# POLICE_NUMBER is prepended to contacts on danger incidents (MANUAL_SOS / SAFETY_WORD).
# These are resolved server-side only — never sent to the client.
HOSPITAL_NUMBER=
POLICE_NUMBER=


# Google Maps Platform API Key
GOOGLE_MAPS_PLATFORM_KEY=

# Geoapify API Key for fallback mapping/geocoding
GEOAPIFY_API_KEY=

# Supabase Configuration
SUPABASE_URL=https://lmtdtblkltnnaoqnnmro.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth Secret (DO NOT EXPOSE TO FRONTEND)
JWT_SECRET=

# ── Feature 2: incident engine ──
# Public HTTPS origin Twilio can reach (ngrok / deployed URL). Used for status callbacks, keypress
# webhooks, report links, and to validate Twilio signatures behind proxies.
PUBLIC_BASE_URL=
# Validate X-Twilio-Signature on webhooks (defaults to true in production)
TWILIO_VALIDATE_WEBHOOKS=
# HMAC secret for signed medical-report links (falls back to JWT_SECRET, then to a random
# secret generated once per process boot — set this explicitly in production so report
# links keep validating across restarts and multiple instances)
INCIDENT_SIGNING_SECRET=

# Comma-separated list of origins allowed to open Socket.IO connections (e.g. your deployed
# app URL). Falls back to PUBLIC_BASE_URL, then to same-origin-only in production, or "*" in dev.
ALLOWED_ORIGINS=
# Browser-only Maps key (HTTP-referrer restricted). Falls back to GOOGLE_MAPS_PLATFORM_KEY.
GOOGLE_MAPS_BROWSER_KEY=

# ── Feature 3: offline safety word (Picovoice Porcupine, optional) ──
# npm i @picovoice/porcupine-web @picovoice/web-voice-processor, then put your trained keyword
# (.ppn, WASM platform) under public/wake/ and porcupine_params.pv beside it.
VITE_PICOVOICE_ACCESS_KEY=
VITE_SAFETY_KEYWORD_PATH=
